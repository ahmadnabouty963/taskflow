generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AttachmentKind {
  TASK
  WHITEBOARD
}

enum AttachmentStatus {
  PENDING
  READY
}

enum Language {
  EN
  DE
}

model User {
  id                       String                @id @default(uuid())
  name                     String
  email                    String                @unique
  passwordHash             String
  emailVerifiedAt          DateTime?
  language                 Language              @default(EN)
  isPlatformAdmin          Boolean               @default(false)
  blockedAt                DateTime?
  lastLoginAt              DateTime?
  lastActiveAt             DateTime?
  lastLoginCountry         String?
  lastLoginDevice          String?
  lastLoginBrowser         String?
  sessions                 Session[]
  authTokens               AuthToken[]
  projects                 Project[]
  comments                 Comment[]
  assignedTasks            Task[]                @relation("TaskAssignee")
  calendarEvents           CalendarEvent[]
  ownedWorkspaces          Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships     WorkspaceMember[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationSender")
  updatedWhiteboards       Whiteboard[]
  uploadedAttachments      Attachment[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([createdAt])
  @@index([lastActiveAt])
}

model Workspace {
  id             String                @id @default(uuid())
  name           String
  type           WorkspaceType         @default(TEAM)
  ownerId        String
  owner          User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  invitations    WorkspaceInvitation[]
  labels         Label[]
  projects       Project[]
  calendarEvents CalendarEvent[]
  attachments    Attachment[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([ownerId])
}

model WorkspaceInvitation {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  invitedById String
  invitedBy   User          @relation("WorkspaceInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, email])
  @@index([email])
  @@index([expiresAt])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id          String       @id @default(uuid())
  title       String
  description String?
  color       String       @default("#6D5EF5")
  archivedAt  DateTime?
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  whiteboard  Whiteboard?
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ownerId, archivedAt])
  @@index([workspaceId, archivedAt])
}

model Task {
  id               String         @id @default(uuid())
  title            String
  description      String?
  status           TaskStatus     @default(TODO)
  priority         TaskPriority   @default(MEDIUM)
  dueDate          DateTime?
  recurrence       TaskRecurrence @default(NONE)
  estimatedMinutes Int?
  actualMinutes    Int?
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId       String?
  assignee         User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  labels           Label[]
  subtasks         Subtask[]
  comments         Comment[]
  recurringFromId  String?        @unique
  recurringFrom    Task?          @relation("TaskRecurrence", fields: [recurringFromId], references: [id], onDelete: SetNull)
  nextOccurrence   Task?          @relation("TaskRecurrence")
  attachments      Attachment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([recurrence, dueDate])
}

model Label {
  id          String    @id @default(uuid())
  name        String
  color       String    @default("#6D5EF5")
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Subtask {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  body      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean   @default(false)
  color       String    @default("#2F6049")
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ownerId, startsAt])
  @@index([ownerId, endsAt])
  @@index([workspaceId, startsAt])
}

model Whiteboard {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  elements    Json     @default("[]")
  version     Int      @default(0)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attachment {
  id               String           @id @default(uuid())
  kind             AttachmentKind
  status           AttachmentStatus @default(PENDING)
  fileName         String
  contentType      String
  size             Int
  storageKey       String           @unique
  workspaceId      String
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId           String?
  task             Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  whiteboardFileId String?
  uploadedById     String?
  uploadedBy       User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([projectId, whiteboardFileId])
  @@index([taskId, status])
  @@index([workspaceId, status])
}

model AuthToken {
  id        String        @id @default(uuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Cookieless visitor statistics. A visitor is only recognisable within one
// day: visitorHash mixes the IP and browser with a salt that is replaced
// daily, and neither the IP nor old salts are kept.
model PageView {
  id           String   @id @default(uuid())
  path         String
  referrerHost String?
  country      String?
  device       String?
  browser      String?
  visitorHash  String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([visitorHash, createdAt])
}

model AnalyticsSalt {
  day       String   @id
  salt      String
  createdAt DateTime @default(now())
}

// Page views older than twelve months are folded into these monthly totals.
model MonthlyTraffic {
  month     String @id
  visitors  Int
  pageViews Int
}
