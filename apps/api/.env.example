DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/taskflow?schema=public"
PORT=3000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5500,http://localhost:5501
API_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
RESEND_API_KEY="re_your_resend_key"
EMAIL_FROM="Ordanly <hello@ordanly.com>"
CLIENT_APP_URL="http://localhost:5173"

# Cloudflare R2 file storage (create a bucket-scoped "Object Read & Write" token)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ordanly-uploads-dev
# Set to "eu" for buckets created with the EU jurisdiction
R2_JURISDICTION=eu
